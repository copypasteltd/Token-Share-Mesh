{
  "version": "P11_CONTROL_HTTP_R005",
  "base_path": "/v1/p11",
  "scope": "23 registered control operations; partial conformance only; no automatic seller/listing approval or execution",
  "operations": [
    {
      "operation_id": "createAuthChallenge",
      "method": "POST",
      "path": "/auth/challenges",
      "handler": "challenge",
      "anonymous": true
    },
    {
      "operation_id": "createUserSession",
      "method": "POST",
      "path": "/auth/sessions",
      "handler": "login",
      "anonymous": true
    },
    {
      "operation_id": "getCurrentSession",
      "method": "GET",
      "path": "/auth/session",
      "handler": "currentSession",
      "anonymous": false
    },
    {
      "operation_id": "revokeUserSession",
      "method": "DELETE",
      "path": "/auth/session",
      "handler": "currentSession",
      "anonymous": false
    },
    {
      "operation_id": "getSelfProfile",
      "method": "GET",
      "path": "/me",
      "handler": "me",
      "anonymous": false
    },
    {
      "operation_id": "listApiKeys",
      "method": "GET",
      "path": "/api-keys",
      "handler": "keys",
      "anonymous": false
    },
    {
      "operation_id": "createApiKey",
      "method": "POST",
      "path": "/api-keys",
      "handler": "keys",
      "anonymous": false
    },
    {
      "operation_id": "revokeApiKey",
      "method": "DELETE",
      "path": "/api-keys/{key_id}",
      "handler": "revokeKey",
      "anonymous": false
    },
    {
      "operation_id": "listServices",
      "method": "GET",
      "path": "/services",
      "handler": "services",
      "anonymous": false
    },
    {
      "operation_id": "createQuote",
      "method": "POST",
      "path": "/quotes",
      "handler": "quote",
      "anonymous": false
    },
    {
      "operation_id": "getQuote",
      "method": "GET",
      "path": "/quotes/{quote_id}",
      "handler": "getQuote",
      "anonymous": false
    },
    {
      "operation_id": "createOrder",
      "method": "POST",
      "path": "/orders",
      "handler": "order",
      "anonymous": false
    },
    {
      "operation_id": "getOrder",
      "method": "GET",
      "path": "/orders/{order_id}",
      "handler": "getOrder",
      "anonymous": false
    },
    {
      "operation_id": "recordConsent",
      "method": "POST",
      "path": "/me/consents",
      "handler": "recordConsent",
      "anonymous": false
    },
    {
      "operation_id": "createSellerApplication",
      "method": "POST",
      "path": "/seller/applications",
      "handler": "sellerApplication",
      "anonymous": false
    },
    {
      "operation_id": "getSellerProfile",
      "method": "GET",
      "path": "/seller/profile",
      "handler": "sellerProfile",
      "anonymous": false
    },
    {
      "operation_id": "requestSellerExit",
      "method": "POST",
      "path": "/seller/exit",
      "handler": "sellerExit",
      "anonymous": false
    },
    {
      "operation_id": "listOwnListings",
      "method": "GET",
      "path": "/seller/listings",
      "handler": "ownListings",
      "anonymous": false
    },
    {
      "operation_id": "createListing",
      "method": "POST",
      "path": "/seller/listings",
      "handler": "ownListings",
      "anonymous": false
    },
    {
      "operation_id": "getOwnListing",
      "method": "GET",
      "path": "/seller/listings/{listing_id}",
      "handler": "ownListing",
      "anonymous": false
    },
    {
      "operation_id": "updateFutureListing",
      "method": "PATCH",
      "path": "/seller/listings/{listing_id}",
      "handler": "ownListing",
      "anonymous": false
    },
    {
      "operation_id": "submitListing",
      "method": "POST",
      "path": "/seller/listings/{listing_id}/submit",
      "handler": "listingState",
      "anonymous": false
    },
    {
      "operation_id": "pauseListing",
      "method": "POST",
      "path": "/seller/listings/{listing_id}/pause",
      "handler": "listingState",
      "anonymous": false
    }
