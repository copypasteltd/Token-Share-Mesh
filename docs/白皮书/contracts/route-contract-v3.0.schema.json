{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p11.invalid/design/route-contract-v3.0.schema.json",
  "title": "P11 confirmed route contract draft",
  "$ref": "#/$defs/RouteContract",
  "$defs": {
    "RouteContractWrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirmed_order_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "seller_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "listing_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "listing_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "budget_per_call_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_budget_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_call_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "purchase_authorization_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "recipient_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "recipient_key_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "confirmed_order_id",
        "seller_id",
        "listing_id",
        "listing_revision",
        "policy",
        "budget_per_call_fen",
        "total_budget_fen",
        "max_call_count",
        "expires_at",
        "purchase_authorization_ref"
      ],
      "description": "confirmed_order_id绑定原订单；purchase_authorization_ref引用同单原始payments.id，不是客户端自报支付。R015仅实现PLAINTEXT/STANDARD和三种native文本profile；E2E/租赁拒绝，不自动降级。配置不授予执行权。",
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "properties": {
                  "service_mode": {
                    "const": "E2E"
                  }
                },
                "required": [
                  "service_mode"
                ]
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "required": [
              "recipient_id",
              "recipient_key_hash"
            ]
          }
        }
      ]
    },
    "RouteContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "buyer_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "definition": {
          "$ref": "#/$defs/RouteContractWrite"
        },
        "state": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "EXPIRED",
            "REVOKED"
          ]
        },
        "remaining_budget_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contract_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "public_model": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "protocol_profile_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "order_contract": {
          "type": "object"
        }
      },
      "required": [
        "route_id",
        "buyer_id",
        "version",
        "definition",
        "state",
        "remaining_budget_fen",
        "used_calls",
        "contract_hash"
      ],
      "description": "R015已实现响应额外给出冻结订单快照、模型及profile修订；历史设计示例不构成实际支付/执行资格。used_calls当前为0，调用签发和调用次数约束尚未接通。"
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_mode": {
          "type": "string",
          "enum": [
            "PLAINTEXT",
            "E2E",
            "GPU_RENTAL"
          ]
        },
        "privacy_profile": {
          "type": "string",
          "enum": [
            "STANDARD",
            "PLATFORM_BLIND",
            "ATTESTED_CONFIDENTIAL"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "protocol_profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "acceptance_policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        },
        "disclosure_version": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$",
          "maxLength": 128
        }
      },
      "required": [
        "service_mode",
        "privacy_profile",
        "region",
        "protocol_profile_id",
        "acceptance_policy_id",
        "disclosure_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "service_mode": {
                "const": "PLAINTEXT"
              }
            },
            "required": [
              "service_mode"
            ]
          },
          "then": {
            "properties": {
              "privacy_profile": {
                "const": "STANDARD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service_mode": {
                "const": "E2E"
              }
            },
            "required": [
              "service_mode"
            ]
          },
          "then": {
            "properties": {
              "privacy_profile": {
                "type": "string",
                "enum": [
                  "PLATFORM_BLIND",
                  "ATTESTED_CONFIDENTIAL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service_mode": {
                "const": "GPU_RENTAL"
              }
            },
            "required": [
              "service_mode"
            ]
          },
          "then": {
            "properties": {
              "privacy_profile": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "ATTESTED_CONFIDENTIAL"
                ]
              }
            }
          }
        }
      ],
      "description": "GPU_RENTAL的加密组合还需单独证据；schema合法不表示已可售。"
    }
  },
  "description": "标准SDK请求外的已确认控制合同。不能凭schema合法自动购付或跨卖家；签名/支付/设备与证据另验证。"
}
